{
  "name": "kit-ty",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.17 <23"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "dev": "pnpm -r --parallel --filter './apps/*' dev",
    "rln:gen": "pnpm --filter @kitty/rln-client gen",
    "dev:fakes": "KITTY_FAKES=1 pnpm dev",
    "infra:up": "./infra/scripts/up.sh",
    "infra:down": "./infra/scripts/down.sh",
    "infra:reset": "./infra/scripts/reset.sh",
    "infra:check": "./infra/scripts/check.sh",
    "demo:reset": "./infra/scripts/demo-reset.sh",
    "demo:unlock": "./infra/scripts/unlock.sh",
    "e2e:wallet": "vitest run -c apps/agent/src/wallet/vitest.integration.config.ts",
    "e2e:close": "vitest run -c apps/agent/src/wallet/vitest.close.config.ts",
    "e2e:demo": "./infra/scripts/e2e.sh demo",
    "e2e:demo:v2": "KITTY_REGISTRY=v2 ./infra/scripts/e2e.sh demo",
    "ai:eval": "pnpm --filter @kitty/agent ai:eval",
    "ai:eval:speech": "pnpm --filter @kitty/agent ai:eval:speech",
    "ai:eval:simple": "AI_EVAL_SET=simple pnpm --filter @kitty/agent ai:eval",
    "ai:eval:offline": "sandbox-exec -f infra/scripts/offline.sb pnpm --offline --filter @kitty/agent ai:eval",
    "e2e:liquidity": "./infra/scripts/e2e.sh liquidity",
    "demo:lose-phone": "./infra/scripts/lose-phone.sh",
    "e2e:lose-phone": "./infra/scripts/e2e.sh lose-phone",
    "e2e:onchain": "./infra/scripts/e2e.sh onchain"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
