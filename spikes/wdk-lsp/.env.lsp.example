# utexo-lsp config for the spike (regtest, test-only values). Copy to .env.lsp and set SUPPORTED_ASSET_IDS.
SERVER_ADDR=:8080
DATABASE_DRIVER=sqlite
DATABASE_URL=/data/utexo_lsp.db
LSP_BASE_URL=http://lsp-rln:3001
RGB_NODE_BASE_URL=http://lsp-rln:3001
RGB_INVOICE_TRANSPORT_ENDPOINTS=rpc://127.0.0.1:3100/json-rpc
CRON_EVERY=3s
MIN_CONFIRMATIONS=1
SENDRGB_FEE_RATE=2
LSP_NODE_HOST=127.0.0.1
LSP_NODE_PORT=29735
LIGHTNING_ADDRESS_DOMAIN_URL=http://127.0.0.1:29380
APAY_BEARER_TOKEN=spike-local-apay-only
DEFAULT_CHANNEL_CAPACITY_SAT=1000000
DEFAULT_CHANNEL_PUSH_MSAT=200000000
DEFAULT_CHANNEL_ASSET_AMOUNT=3000
DEFAULT_VIRTUAL_OPEN_MODE=
UTXO_MIN_COUNT=4
UTXO_TARGET_COUNT=8
UTXO_SIZE_SAT=1100000
UTXO_FEE_RATE=2
SUPPORTED_ASSET_IDS=
