# kit+ty infra and seed variables. Copy to infra/.env (gitignored, chmod 600).
# Regtest only. No secret is ever written here: passwords and mnemonics stay blank.

# Node REST APIs, bound to 127.0.0.1 (apps/agent/src/config.ts reads these).
RLN_ALICE_URL=http://127.0.0.1:3001
RLN_BOB_URL=http://127.0.0.1:3002
RLN_CHARLIE_URL=http://127.0.0.1:3003
RLN_DAVE_URL=http://127.0.0.1:3004

# Esplora REST (proofs: /tx/<txid>) and the RGB proxy (consignments).
ESPLORA_URL=http://127.0.0.1:3010
RGB_PROXY_URL=http://127.0.0.1:3000/json-rpc
# Addresses as seen from inside the compose network (used in RLN /unlock and invoices).
RGB_PROXY_URL_INTERNAL=rpc://proxy:3000/json-rpc
ELECTRS_URL_INTERNAL=electrs:50001
BITCOIND_RPC_HOST=bitcoind
BITCOIND_RPC_PORT=18443
BITCOIND_RPC_USER=user
# Upstream regtest RPC password (matches RPCAUTH in docker-compose.yml); fill it in .env.
BITCOIND_RPC_PASSWORD=

# RLN node passwords: required, random, at least 8 characters.
RLN_ALICE_PASSWORD=
RLN_BOB_PASSWORD=
RLN_CHARLIE_PASSWORD=
RLN_DAVE_PASSWORD=
# Written back by the seed (B2) when a node is initialized; never commit them.
RLN_ALICE_MNEMONIC=
RLN_BOB_MNEMONIC=
RLN_CHARLIE_MNEMONIC=
RLN_DAVE_MNEMONIC=

# Modes (SPEC §10.4, §14.0). demo:reset refuses KITTY_FAKES=1.
KITTY_RAIL_MODE=ln-2ch
KITTY_WALLET_ENGINE=rln-rest
KITTY_FAKES=0

# Seconds infra scripts wait for a service before failing.
TIMEOUT=120
